<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../MiniHelpDesk/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../MiniHelpDesk/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../MiniHelpDesk/Commands/*.cs" Link="Commands/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
